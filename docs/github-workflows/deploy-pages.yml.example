# DonationChain — auto-deploy on every push to main
# Pages: Settings → Source = "GitHub Actions" OR branch "gh-pages" / root

name: Deploy Web to GitHub Pages

on:
  push:
    branches: [main, master]
  workflow_dispatch:
    inputs:
      reason:
        description: "Manual deploy reason"
        required: false
        default: "Manual deploy"

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: pages-${{ github.ref }}
  cancel-in-progress: true

env:
  WEB_DIR: donationchain

jobs:
  build:
    name: Build & validate
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Verify required files
        run: |
          set -euo pipefail
          required=(
            index.html js/app.js js/config.js js/i18n.js js/ledger.js js/merkle.js
            admin/index.html admin/login.html
            donor/dashboard.html explorer.html
            manifest.json sw.js css/rtl.css
            js/admin-auth.js
          )
          for f in "${required[@]}"; do
            if [[ ! -f "${{ env.WEB_DIR }}/$f" ]]; then
              echo "::error::Missing ${{ env.WEB_DIR }}/$f"
              exit 1
            fi
            echo "  ✓ $f"
          done

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Syntax-check JavaScript
        run: |
          set -euo pipefail
          for f in ${{ env.WEB_DIR }}/js/*.js; do
            node --check "$f"
            echo "OK $f"
          done

      - name: Prepare _site
        run: |
          mkdir -p _site
          cp -a ${{ env.WEB_DIR }}/. _site/
          find _site -name '*.map' -delete 2>/dev/null || true
          echo "<!-- deployed $(date -u +%Y-%m-%dT%H:%M:%SZ) ${{ github.sha }} -->" >> _site/index.html

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: _site

      - name: Upload site for branch publish
        uses: actions/upload-artifact@v4
        with:
          name: site-static
          path: _site
          retention-days: 2

      - name: Summary
        run: |
          {
            echo "## Auto-deploy build"
            echo "| Item | Value |"
            echo "|------|-------|"
            echo "| Commit | \`${{ github.sha }}\` |"
            echo "| Branch | \`${{ github.ref_name }}\` |"
            echo "| Actor | ${{ github.actor }} |"
            find "${{ env.WEB_DIR }}" -type f | wc -l | xargs -I{} echo "| Files | {} |"
          } >> "$GITHUB_STEP_SUMMARY"

  deploy-actions:
    name: Deploy (Pages Actions)
    needs: build
    runs-on: ubuntu-latest
    continue-on-error: true
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4

  deploy-branch:
    name: Deploy (gh-pages branch)
    needs: build
    runs-on: ubuntu-latest
    steps:
      - name: Download site
        uses: actions/download-artifact@v4
        with:
          name: site-static
          path: _site

      - name: Publish to gh-pages
        uses: peaceiris/actions-gh-pages@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: _site
          publish_branch: gh-pages
          force_orphan: true
          user_name: github-actions[bot]
          user_email: github-actions[bot]@users.noreply.github.com

      - name: How to enable Pages
        run: |
          {
            echo "### Live site"
            echo "https://mrbahramkhan.github.io/donationchain/"
            echo ""
            echo "**Settings → Pages**"
            echo "- Preferred: Source **Deploy from a branch** → **gh-pages** / **/(root)**"
            echo "- Or: Source **GitHub Actions**"
          } >> "$GITHUB_STEP_SUMMARY"
