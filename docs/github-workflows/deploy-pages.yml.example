# DonationChain — GitHub Pages deploy
# Method A: official actions/deploy-pages (needs Settings → Pages → Source: GitHub Actions)
# Method B: fallback pushes to gh-pages branch (needs Settings → Pages → Branch: gh-pages / root)
#
# If you see "Failed to create deployment (status: 404)", use Method B settings below.

name: Deploy Web to GitHub Pages

on:
  push:
    branches: [main, master]
    paths:
      - "donationchain/**"
      - ".github/workflows/deploy-pages.yml"
  workflow_dispatch:
    inputs:
      reason:
        description: "Why are you redeploying?"
        required: false
        default: "Manual deploy"

# contents:write needed for gh-pages branch push fallback
permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: pages-${{ github.ref }}
  cancel-in-progress: true

env:
  WEB_DIR: donationchain

jobs:
  build:
    name: Build & validate
    runs-on: ubuntu-latest
    steps:
      - name: Checkout (sparse)
        uses: actions/checkout@v4
        with:
          fetch-depth: 1
          sparse-checkout: |
            donationchain
          sparse-checkout-cone-mode: true

      - name: Verify required files
        run: |
          set -euo pipefail
          required=(
            index.html js/app.js js/config.js js/i18n.js js/ledger.js js/merkle.js
            admin/index.html donor/dashboard.html explorer.html
            manifest.json sw.js css/rtl.css
          )
          for f in "${required[@]}"; do
            if [[ ! -f "${{ env.WEB_DIR }}/$f" ]]; then
              echo "::error::Missing $f"
              exit 1
            fi
            echo "  ✓ $f"
          done

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Syntax-check JavaScript
        run: |
          for f in ${{ env.WEB_DIR }}/js/*.js; do
            node --check "$f"
          done

      - name: Prepare _site
        run: |
          mkdir -p _site
          cp -a ${{ env.WEB_DIR }}/. _site/
          echo "<!-- deployed $(date -u +%Y-%m-%dT%H:%M:%SZ) ${{ github.sha }} -->" >> _site/index.html

      - name: Upload artifact (for official Pages action)
        uses: actions/upload-pages-artifact@v3
        with:
          path: _site

      - name: Upload site tarball (for branch deploy)
        uses: actions/upload-artifact@v4
        with:
          name: site-static
          path: _site
          retention-days: 1

  # Official GitHub Pages deployment (requires Pages source = GitHub Actions)
  deploy-actions:
    name: Deploy (GitHub Actions source)
    needs: build
    runs-on: ubuntu-latest
    # Continue workflow even if this fails (404 when Pages not configured)
    continue-on-error: true
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4

  # Reliable fallback: publish folder to gh-pages branch
  deploy-branch:
    name: Deploy (gh-pages branch)
    needs: build
    runs-on: ubuntu-latest
    steps:
      - name: Download site
        uses: actions/download-artifact@v4
        with:
          name: site-static
          path: _site

      - name: Publish to gh-pages
        uses: peaceiris/actions-gh-pages@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: _site
          publish_branch: gh-pages
          force_orphan: true
          user_name: github-actions[bot]
          user_email: github-actions[bot]@users.noreply.github.com

      - name: Summary
        run: |
          {
            echo "### Pages deploy"
            echo ""
            echo "1. Open **Settings → Pages**"
            echo "2. Source: **Deploy from a branch**"
            echo "3. Branch: **gh-pages** / folder: **/ (root)**"
            echo "4. Save — site: https://mrbahramkhan.github.io/donationchain/"
            echo ""
            echo "Optional: Source **GitHub Actions** if you prefer the official deploy action."
          } >> "$GITHUB_STEP_SUMMARY"
