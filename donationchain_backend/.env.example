PORT=4000
# Firebase Admin — pick ONE:
# A) Railway / cloud: paste full service account JSON (single line or multi-line)
FIREBASE_SERVICE_ACCOUNT=
# B) Local file path (default config/serviceAccountKey.json)
GOOGLE_APPLICATION_CREDENTIALS=./config/serviceAccountKey.json

# JWT admin auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SEC=7200
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@DC2026

# SMS (mock default). Use twilio for production.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Twilio 20429/429 retries (exponential backoff)
SMS_MAX_RETRIES=4
