# DonationChain backend — production template
NODE_ENV=production
PORT=4000

# Auth
JWT_SECRET=change-me-to-long-random-string
OTP_TTL_SECONDS=300
# Never set OTP_RETURN_CODE=true in production

# SMS (required for real OTP)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Raast / payments
RAAST_MODE=live
RAAST_API_BASE=
RAAST_API_KEY=
RAAST_MERCHANT_IBAN=
RAAST_WEBHOOK_SECRET=
# Retries keep the same UETR + EndToEndId + Idempotency-Key
RAAST_RETRY_MAX=3
RAAST_RETRY_BASE_MS=400
RAAST_RETRY_MAX_MS=4000


# Firebase FCM (optional push)
FIREBASE_SERVICE_ACCOUNT=

# Zakat metal prices (local currency units per gram)
ZAKAT_GOLD_PER_GRAM=
ZAKAT_SILVER_PER_GRAM=
ZAKAT_NISAB_GOLD_GRAMS=85

# Multi-currency FX
FX_BASE_CURRENCY=USD
FX_SPREAD_PERCENT=0
FX_QUOTE_TTL_SEC=600
FX_CACHE_MS=300000
# Optional live rates API returning { rates: { EUR: 0.92, PKR: 278 } } vs USD
# FX_API_URL=
# FX_API_KEY=
# Manual overrides: FX_RATE_PKR=280
